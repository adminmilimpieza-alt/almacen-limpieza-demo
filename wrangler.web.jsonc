{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "milimpieza-web",
  "main": "worker/web.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"./dist", "binding":"FILES", "run_worker_first":true},
  "observability": {"enabled":false}
}
